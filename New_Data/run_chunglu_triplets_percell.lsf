#!/bin/bash
# ============================================================================
# run_chunglu_triplets_percell.lsf — PER-CELL wedge Z for the CLOSED candidate
# list (triplet_candidate_list.json), one LSF array job per PNA sample.
# Much lighter than the pooled run (171 triplets vs C(159,3)); doublets/pooled
# are NOT recomputed here (already in results/chunglu/).
#
# Usage:
#   bsub < run_chunglu_triplets_percell.lsf                                   # all 15 samples
#   bsub -J "clpc-S001" -env "SAMPLE=S001" < run_chunglu_triplets_percell.lsf # single sample
# ============================================================================

#BSUB -J clpc[1-15]
#BSUB -q long
#BSUB -R rusage[mem=32G]
#BSUB -R affinity[thread*16]
#BSUB -o /home/projects/nyosef/zvise/PixelGen/PixelGen/New_Data/results/logs/clpc_%J_%I.out
#BSUB -e /home/projects/nyosef/zvise/PixelGen/PixelGen/New_Data/results/logs/clpc_%J_%I.err

set -euo pipefail

BASE_DIR="/home/projects/nyosef/zvise/PixelGen/PixelGen/New_Data"
ADATA="${BASE_DIR}/cache/adata_annotated.h5ad"
OUTPUT_DIR="${BASE_DIR}/results/chunglu"
TRIPLET_LIST="${OUTPUT_DIR}/triplet_candidate_list.json"
N_WORKERS=16
VAR_MODE="lead"

# Sample list (15 samples, S015 missing from delivery)
SAMPLES=(S001 S002 S003 S004 S005 S006 S007 S008 S009 S010 S011 S012 S013 S014 S016)

if [ -n "${SAMPLE:-}" ]; then
    SAMPLE_NAME="${SAMPLE}"
else
    IDX=$((LSB_JOBINDEX - 1))
    SAMPLE_NAME="${SAMPLES[$IDX]}"
fi

PXL="${BASE_DIR}/results/${SAMPLE_NAME}/layout/layout/${SAMPLE_NAME}.layout.pxl"
if [ ! -f "${PXL}" ]; then
    echo "ERROR: pxl not found: ${PXL}"
    exit 1
fi
if [ ! -f "${TRIPLET_LIST}" ]; then
    echo "ERROR: triplet list not found: ${TRIPLET_LIST} (run build_triplet_list.py first)"
    exit 1
fi

# Keep BLAS single-threaded; we parallelise across cells with ProcessPoolExecutor.
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1
export VECLIB_MAXIMUM_THREADS=1

set +u   # conda activate.d (libblas_mkl) reads unset vars; nounset would abort
eval "$(conda shell.bash hook)"
conda activate /home/projects/nyosef/zvise/.local/share/mamba/envs/pxlgn
set -u

echo "Chung-Lu per-cell wedge (closed list) for ${SAMPLE_NAME}"
mkdir -p "${OUTPUT_DIR}"

python "${BASE_DIR}/chunglu_triplets.py" \
    --sample "${SAMPLE_NAME}" \
    --adata "${ADATA}" \
    --pxl "${PXL}" \
    --output-dir "${OUTPUT_DIR}" \
    --n-workers "${N_WORKERS}" \
    --var-mode "${VAR_MODE}" \
    --triplet-list "${TRIPLET_LIST}"
