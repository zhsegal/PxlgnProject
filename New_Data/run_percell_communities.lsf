#!/bin/bash
# ============================================================================
# run_percell_communities.lsf — LSF job for per-cell community detection
#
# Usage:
#   bsub < run_percell_communities.lsf
# ============================================================================

#BSUB -J percell-comm
#BSUB -q long
#BSUB -R rusage[mem=192G]
#BSUB -R affinity[thread*16]
#BSUB -o /home/projects/nyosef/zvise/PixelGen/PixelGen/New_Data/results/logs/percell_comm_%J.out
#BSUB -e /home/projects/nyosef/zvise/PixelGen/PixelGen/New_Data/results/logs/percell_comm_%J.err

BASE_DIR="/home/projects/nyosef/zvise/PixelGen/PixelGen/New_Data"
CACHE_DIR="${BASE_DIR}/cache"

# Limit threads per process to avoid TERM_THREADLIMIT
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1

# Activate environment
eval "$(conda shell.bash hook)"
conda activate /home/projects/nyosef/zvise/.local/share/mamba/envs/pxlgn

python "${BASE_DIR}/run_percell_communities.py" \
    --proximity-parquet "${CACHE_DIR}/spatial_all_samples.parquet" \
    --output-dir "${CACHE_DIR}" \
    --resolution 0.1 \
    --k-spectral 5 \
    --n-workers 8
